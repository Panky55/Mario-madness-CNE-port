<!DOCTYPE codename-engine-splashes>
<!--
	The mod's own note splash sheet, as a Codename splash group.

	Psych mounts `NoteSplash` with `SONG.splashSkin` and falls back to
	'noteSplashes' when that is empty (`NoteSplash.hx:18-20`), so every songData
	of Mario's Madness ends up there: 20 name 'noteSplashes' and the other 4
	leave the field null.  Codename instead loads one group per `note.splash`
	through `Paths.xml('splashes/<name>')` (`SplashHandler.getSplashGroup`), and
	its own default is `game/splashes/default` - a different sheet - which is why
	`songs/noteskin.hx` points every note at 'noteSplashes' and why this file has
	to exist for the mod's art to show up.

	The mapping is the source's own (`NoteSplash.loadAnims`): strum 0 (left) is
	the purple sheet, 1 (down) blue, 2 (up) green, 3 (right) red, and each
	direction has the two random variants `note splash <colour> 1|2`.  Frame rate
	is the sheet's 24 (`NoteSplash.hx:66-67` picks 24 +/- 2 per splash; the XML
	only takes one value) and the alpha matches Psych's 0.6.

	No x/y offset: Psych places the splash by hand
	(`setPosition(x - Note.swagWidth * 0.95, y - Note.swagWidth)` with
	`offset.set(10, 10)`) while Codename centres it on the strum
	(`SplashGroup.showOnStrum`), the same way the engine's own `default.xml`
	places its sheet, so leaving the offsets out is the faithful choice.
-->
<splashes sprite="game/splashes/noteSplashes" alpha="0.6">
	<strum id="0"> <!-- LEFT / purple -->
		<anim name="splashleft1" anim="note splash purple 1" fps="24" />
		<anim name="splashleft2" anim="note splash purple 2" fps="24" />
	</strum>
	<strum id="1"> <!-- DOWN / blue -->
		<anim name="splashdown1" anim="note splash blue 1" fps="24" />
		<anim name="splashdown2" anim="note splash blue 2" fps="24" />
	</strum>
	<strum id="2"> <!-- UP / green -->
		<anim name="splashup1" anim="note splash green 1" fps="24" />
		<anim name="splashup2" anim="note splash green 2" fps="24" />
	</strum>
	<strum id="3"> <!-- RIGHT / red -->
		<anim name="splashright1" anim="note splash red 1" fps="24" />
		<anim name="splashright2" anim="note splash red 2" fps="24" />
	</strum>
</splashes>
